###############################
# Core chain / RPC endpoints
###############################

# RPC endpoint for seed and load test scripts
LOADTEST_RPC=http://localhost:36657

# Chain ID used for signing transactions
LOADTEST_CHAIN_ID=localperpxprotocol

# Fee denomination for load tests (native token)
LOADTEST_DENOM=aperpx

# Optional override for REST and gRPC base URLs (normally derived from LOADTEST_RPC)
LOADTEST_REST_URL=http://localhost:31317
LOADTEST_GRPC_URL=http://localhost:39090

###############################
# Loadtest engine defaults
###############################

# Default WebSocket endpoints for the loadtest engine / scripts
WS_URL=ws://localhost:36657/websocket
WS_ENDPOINTS=ws://localhost:36657/websocket

# Default benchmark parameters used by scripts/run_benchmark.sh
WORKERS=10
DURATION=30
RATE=50

# UI mode for standalone loadtest: plain | tui
UI_MODE=plain

# Quiet mode for benchmark script (true = single-line progress)
QUIET=true

# Stream full logs to terminal in benchmark script
SHOW_LIVE_LOGS=false


###############################
# Script-level toggles
###############################

# Skip building the perpx-load-test binary in scripts
SKIP_BUILD=false

# Skip seeding in scripts
SKIP_SEED=false

# Output directory for CSV/JSON/log artifacts
OUTPUT_DIR=./exported


###############################
# Seeding configuration
###############################

# Number of worker accounts to seed when invoking `perpx-load-test seed`
# directly (the scripts typically derive this from WORKERS / YAML).
LOADTEST_WORKERS=10

# Seed key / mnemonic for seeding
LOADTEST_SEED_KEY=

# Hex-encoded private key for seeding (takes precedence over LOADTEST_SEED_KEY when set)
LOADTEST_SEED_PRIVATE_KEY=

# Base amount to fund each account (bank balance).
# In normal flows this is auto-computed per run by scripts/run_benchmark.sh
# and scripts/run_perps_load.sh; override only for manual seeding or special cases.
LOADTEST_FUND_AMOUNT=1000000000000000000aperpx

# Batch size for seed funding transactions
LOADTEST_BATCH_SIZE=50

# Seeding mode: "bank" (only bank balances) or "perps" (bank + perps margin deposits)
LOADTEST_PERPS_SEED_MODE=perps

# Perps margin deposit per account (USDC quantums)
LOADTEST_PERPS_DEPOSIT=10000000000

###############################
# Perps scenario configuration
###############################

# Scenario preset: simple_perps | maker_taker | stress_mixed | advanced_perps
LOADTEST_PERPS_SCENARIO=simple_perps

# Comma-separated market specs:
#   clobPairID:symbol:minQty-maxQty:minSubticks-maxSubticks
# Example: 1:ETH-PERP:1000000-10000000:100000-200000
LOADTEST_PERPS_MARKETS=1:ETH-PERP:1000000-10000000:100000-200000

# Optional override for perps action weights:
# "place,cancel,amend,close,noop" (e.g. "80,5,5,10,0")
# LOADTEST_PERPS_ACTION_WEIGHTS=80,5,5,10,0

# Max orders tracked per worker for cancels/amends
LOADTEST_PERPS_MAX_TRACKED_ORDERS=1024

# Optional leverage range overrides
# LOADTEST_PERPS_MIN_LEVERAGE=1.0
# LOADTEST_PERPS_MAX_LEVERAGE=10.0

# Price/size quantization (must match on-chain CLOB config)
# Subticks per tick (price grid) and step base quantums (size grid)
LOADTEST_PERPS_SUBTICKS_PER_TICK=100000
LOADTEST_PERPS_STEP_BASE_QUANTUMS=1000000

# Mid-price / market-data based pricing
# Enable mid-price and configure data source + cache TTL
LOADTEST_PERPS_USE_MID_PRICE=true
LOADTEST_PERPS_MARKET_DATA_URL=http://localhost:41317
LOADTEST_PERPS_MARKET_DATA_CACHE_TTL_SECONDS=3

# Advanced perps probabilities (0-100)
# Long-term orders, conditional orders, TWAP orders, and batch cancels.
# LOADTEST_PERPS_LONG_TERM_PCT=30
# LOADTEST_PERPS_CONDITIONAL_PCT=15
# LOADTEST_PERPS_TWAP_PCT=10
# LOADTEST_PERPS_BATCH_CANCEL_PCT=0

# TWAP configuration
# LOADTEST_PERPS_TWAP_INTERVAL_SECONDS=60
# LOADTEST_PERPS_TWAP_NUM_INTERVALS=5

# Conditional order price offset, in basis points around mid-price (default 0)
# LOADTEST_PERPS_PRICE_OFFSET_BPS=0

# Optional base RNG seed for deterministic perps behavior; each worker derives
# its own RNG stream from this base. When unset, a time-based seed is used.
# Example: LOADTEST_PERPS_RNG_SEED=123456789
LOADTEST_PERPS_RNG_SEED=


###############################
# Perps client behavior / safety
###############################

# Deterministic client ID assignment (useful for reproducible tests)
LOADTEST_PERPS_DETERMINISTIC_CLIENT_IDS=true

# Optional starting client ID when deterministic IDs are enabled
# LOADTEST_PERPS_CLIENT_ID_START=1

# Retry and backoff behavior for perps tx submission
# LOADTEST_PERPS_MAX_RETRIES=3
# LOADTEST_PERPS_RETRY_DELAY_MS=250

# Margin checking behavior
# Enable/disable pre-flight margin checks in the perps client.
# LOADTEST_PERPS_ENABLE_MARGIN_CHECK=true

# Minimum margin ratio (e.g. 0.05 for 5%)
# LOADTEST_PERPS_MIN_MARGIN_RATIO=0.05

# Policy on insufficient margin (matches implementation):
#   "skip"    - log and skip order
#   "deposit" - attempt additional margin deposit before placing
#   "close"   - close positions instead of placing new risk-increasing orders
# LOADTEST_PERPS_ON_INSUFFICIENT_MARGIN=skip

# Tx-status monitoring
# When true, the perps client will poll REST for transaction inclusion/success.
LOADTEST_PERPS_MONITOR_TX_STATUS=false

# Number of ms to wait before first tx-status check
# LOADTEST_PERPS_TX_CHECK_DELAY_MS=500

# Maximum number of tx-status checks per monitored transaction
# LOADTEST_PERPS_TX_MAX_CHECKS=60

# Sample rate for tx-status monitoring (1 = every tx, 10 = ~10% of txs, etc.)
# LOADTEST_PERPS_TX_MONITOR_SAMPLE_RATE=1

# Optional timestamp-based client ID nonce toggling
# LOADTEST_PERPS_USE_TIMESTAMP_NONCE=false


###############################
# Perps fee / gas overrides
###############################

# Optional fee/gas overrides for perps transactions. When unset, perps client
# uses its own defaults.
#
# Gas limit per perps tx (integer)
# LOADTEST_PERPS_FEE_GAS_LIMIT=200000
#
# Min gas price in base units per unit gas (e.g. 25000000000 for 25e9 aperpx/gas)
# LOADTEST_PERPS_FEE_MIN_GAS_PRICE=25000000000
#
# Alternate fee denom and min gas price (if chain supports multi‑denom fees)
# LOADTEST_PERPS_FEE_ALT_DENOM=usdc
# LOADTEST_PERPS_FEE_ALT_MIN_GAS_PRICE=1000000


###############################
# Debugging
###############################

# When true, include worker IDs in per‑tx logs for debugging worker sharding /
# sender targeting.
# LOADTEST_DEBUG_LOG_WORKER_IDS=true




